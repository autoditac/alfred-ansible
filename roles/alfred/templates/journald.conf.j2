[Journal]
Storage={{ alfred_journald_storage }}
{% if alfred_journald_storage == "persistent" %}
SystemMaxUse={{ alfred_journald_system_max_use }}
SystemKeepFree={{ alfred_journald_system_keep_free }}
SystemMaxFileSize={{ alfred_journald_system_max_file_size }}
{% else %}
RuntimeMaxUse={{ alfred_journald_runtime_max_use }}
{% endif %}
MaxLevelStore={{ alfred_journald_max_level_store }}
